{
  "name": "the-atrium",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w apps/server\" \"npm run dev -w apps/client\"",
    "build": "npm run build -w apps/client && tsc -p apps/server/tsconfig.json",
    "typecheck": "tsc --noEmit -p apps/client/tsconfig.json && tsc --noEmit -p apps/server/tsconfig.json",
    "test": "tsx --test apps/server/src/*.test.ts",
    "lint": "eslint .",
    "security:scan": "python3 scripts/security-scan.py",
    "release:check": "npm run typecheck && npm run lint && npm run build && npm test && npm run security:scan && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
