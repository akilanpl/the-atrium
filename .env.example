# Local development; never commit a real .env file.
NODE_ENV=development
PORT=2567
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production/staging serving a production build:
# NODE_ENV=production
# TLS_PROXY=1
# ALLOWED_ORIGINS=https://atrium.example.com
# Client defaults to same-host WSS in production.
# VITE_SERVER_URL=wss://atrium.example.com
